/* Feuille de style de l'assistant. */

Screen {
    background: $surface;
}

Header {
    background: $primary-darken-2;
}

#welcome, #paths, #services, #summary, #report, #vpn {
    padding: 1 2;
    height: 1fr;
}

/* Un `Vertical` vaut `height: 1fr` par defaut : sa taille vient de la place
   disponible, pas de son contenu. Sur une fenetre courte, ces trois blocs se
   reduisaient a UNE ligne et leurs champs disparaissaient, superposes au bloc
   suivant. Constate a l'usage : le message reclamait la cle privee WireGuard
   alors que le champ pour la saisir etait ecrase hors de vue. `auto` fait
   dependre la hauteur du contenu, et le defilement de `#vpn` fait le reste. */
#vpn-details, #vpn-wireguard, #vpn-openvpn {
    height: auto;
}

/* La liste des lieux peut compter deux cents entrees : lui laisser prendre
   toute la place ferait disparaitre le bouton Continuer. Hauteur bornee, et
   c'est elle qui defile. */
#vpn-lieux {
    height: 8;
    border: tall $panel;
}

#pitch {
    padding: 1 2;
    background: $panel;
    border-left: thick $primary;
    margin-bottom: 1;
}

.group-title {
    text-style: bold;
    color: $accent;
    margin: 1 0 0 0;
}

.service {
    margin-left: 2;
}

#docker-status {
    padding: 1 2;
    background: $panel;
    margin: 1 0;
}

#selection-summary, #summary-paths, #summary-warnings, #paths-check, #report-next {
    padding: 1 2;
    background: $panel;
    margin-top: 1;
}

#summary-warnings {
    border-left: thick $warning;
}

#install-phase {
    padding: 1 2;
    background: $panel;
    border-left: thick $primary;
    margin: 1 2;
}

#install-log {
    height: 1fr;
    margin: 0 2;
    border: round $primary-darken-2;
    padding: 0 1;
}

.actions {
    height: auto;
    padding: 1 2;
    align: left middle;
}

.actions Button {
    margin-right: 2;
}

DataTable {
    height: auto;
    max-height: 20;
    margin-bottom: 1;
}

Input {
    margin-left: 2;
}

RadioSet {
    margin-left: 2;
    border: none;
}

/* -- selection des services ------------------------------------------------ */

#services {
    height: 1fr;
    padding: 0 1;
}

.service-column {
    width: 1fr;
    padding: 0 1;
}

Checkbox.service {
    border: none;
    padding: 0 1;
    background: transparent;
    margin-left: 1;
}

Checkbox.service:focus {
    background: $primary-darken-3;
}

/* Coche bien lisible : c'est l'element que l'oeil doit trouver en premier. */
Checkbox.service > .toggle--button {
    background: $panel-lighten-2;
    color: $primary-darken-3;
}

Checkbox.service.-on > .toggle--button {
    background: $success;
    color: $success-darken-3;
}

.service-note {
    color: $text-muted;
    margin: 0 0 1 5;
}

/* Les descriptions doivent passer a la ligne plutot qu'etre coupees. */
.service-note {
    width: 1fr;
    text-wrap: wrap;
}

/* -- etape indexeurs ------------------------------------------------------- */

#indexers-intro {
    padding: 1 2;
    margin: 1 2 0 2;
    background: $panel;
    border-left: thick $warning;
}

#indexers-body {
    height: 1fr;
    padding: 1 2;
}

/* Import d'une sauvegarde Prowlarr : parite avec l'assistant web. */
#indexer-backup {
    height: auto;
    padding: 1 2 0 2;
}

#backup-path {
    width: 1fr;
}

#backup-list {
    height: auto;
    max-height: 12;
    margin: 0 2;
}

#backup-import {
    margin: 0 2;
}

.indexers-pane {
    width: 1fr;
    padding: 0 1;
}

#indexer-results {
    height: 1fr;
    border: round $primary-darken-2;
}

#indexer-form {
    border: round $primary-darken-2;
    padding: 0 1;
}

/* Les champs d'indexeur restent compacts : un terminal court doit afficher
   l'URL ET les identifiants sans faire defiler. */
.indexer-field {
    margin: 0;
    height: 3;
}

#indexer-form .group-title {
    margin: 0;
}

.indexer-title {
    margin-bottom: 1;
}

#indexer-status {
    padding: 1 2;
    margin: 0 2;
    background: $panel;
}

/* -- bandeau de titre ------------------------------------------------------ */

#wizard-header {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
    text-align: center;
    text-style: bold;
}

.hidden {
    display: none;
}
